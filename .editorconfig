root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{js,jsx,mjs,json,css,html,yml,yaml}]
indent_size = 2

# Data and prose: whitespace can be part of the content
[*.{jsonl,json,md}]
trim_trailing_whitespace = false
