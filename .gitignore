# Node / React
node_modules/
dashboard/node_modules/
.vite/
dashboard/dist/

# Pipeline outputs: regenerated by `python -m pipeline.run` (+ pipeline.heal /
# pipeline.changelog). Only data/raw/ (the source PDFs) is tracked under data/.
# Results meant to be shared go in docs/evidence/<stream>/, copied on purpose.
data/extracted/
data/cleaned/
data/deduped/
data/filtered/
data/redacted/
data/output/
data/healed/

# OS
.DS_Store
Thumbs.db

# Editors
.vscode/
.idea/

# Logs (nemo_curator_install.log / spacy_model_dl.log in logs/ are kept
# as tracked evidence of the documented install failure -- see README)
logs/*.log

# Local harness/session state (not project-relevant, churns per session)
.claude/scheduled_tasks.lock
